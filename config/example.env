# GITHUB_TOKEN example
# Copy this file to .env.local and fill in your actual token

# GitHub API token (required for API calls)
GITHUB_TOKEN=your_github_token_here

# Optional: GitHub username for API calls
GITHUB_USERNAME=smpsandro1239

# Optional: Organization or repository owner (if not using username)
REPO_OWNER=smpsandro1239

# Repository name
REPO_NAME=AldeiasGames

# Optional: Default branch
DEFAULT_BRANCH=main