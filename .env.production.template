# ============================================================================
# AldeiasGames — Template de variáveis de ambiente para a VERCEL (Produção)
# ----------------------------------------------------------------------------
# ⚠️  Este ficheiro NÃO contém segredos reais. Preenche os <PLACEHOLDERS>.
# ⚠️  Todos os segredos antigos que foram partilhados estão COMPROMETIDOS e
#     têm de ser substituídos por valores NOVOS rotacionados (ver instruções).
# ============================================================================

# --- Base de dados (Neon PostgreSQL) ---
# Reset password no Neon Console → endpoint → "Reset password" → copia a NOVA connection string
DATABASE_URL="<NOVA_STRING_NEON_com_senha_rotacionada>"

# --- JWT (auth própria do projeto) ---
# Gera um valor novo: openssl rand -base64 48
JWT_SECRET="<GERA_UM_VALOR_NOVO_COM_OPENSSL_RAND>"

# --- NextAuth v5 ---
# Gera um valor novo: openssl rand -base64 32
NEXTAUTH_SECRET="<GERA_UM_VALOR_NOVO_COM_OPENSSL_RAND>"
NEXTAUTH_URL="https://aldeias-games.vercel.app"

# --- URLs públicas da app ---
NEXT_PUBLIC_APP_URL="https://aldeias-games.vercel.app"
NEXT_PUBLIC_BASE_URL="https://aldeias-games.vercel.app"

# --- Stripe ---
# Stripe Dashboard → Developers → API keys → "Roll secret" → cola a nova sk_test_
STRIPE_SECRET_KEY="<NOVA_sk_test_DO_STRIPE apos Roll>"
# Stripe Dashboard → Developers → Webhooks → endpoint → Copy signing secret (começa por whsec_)
STRIPE_WEBHOOK_SECRET="<whsec_..._DO_STRIPE>"

# --- Google OAuth ---
# Google Cloud Console → Credentials → Regenerate client secret
GOOGLE_CLIENT_ID="1077673425073-1v2shsm8jm95qa5pk6mo5i41ubf31k4u.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<NOVO_GOCSPX apos Regenerate>"
# ⚠️ No Google Console acrescenta também o redirect de produção:
#    https://aldeias-games.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI="https://aldeias-games.vercel.app/api/auth/google/callback"

# --- Upstash Redis (rate limiting / carrinho) ---
# Upstash Console → teu Redis → Settings → Regenerate token
UPSTASH_REDIS_REST_URL="https://fine-werewolf-101563.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<NOVO_TOKEN_UPSTASH apos Regenerate>"

# --- MBWay (Ifthenpay) — preencher quando contractares ---
MBWAY_API_KEY=""
MBWAY_ENTITY_CODE=""
MBWAY_ENTITY_PHONE=""
MBWAY_API_URL="https://api.mbway.pt/v1"
MBWAY_SANDBOX="true"
MBWAY_WEBHOOK_SECRET=""

# --- SMS (Twilio) — opcional, deixar vazio por agora ---
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- AWS SNS — opcional, deixar vazio ---
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SNS_TOPIC_ARN=""

# --- Email SMTP — preencher com credenciais reais (Gmail app password ou SendGrid) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@aldeias.pt"

# --- Outros (opcionais, deixar vazio até precisar) ---
OPENROUTER_API_KEY=""
NEON_API_KEY=""
NEXT_PUBLIC_SENTRY_DSN=""

# ============================================================================
# ❌ NÃO ADICIONAR NA VERCEL (causam erros de build/runtime em produção):
#   NODE_ENV               → a Vercel define automaticamente; "development" parte o fail-fast do auth.ts
#   DATABASE_URL="file:./dev.db" → SQLite só funciona em dev local
#   NEXT_PUBLIC_* = http://localhost:3000 → quebraria links em produção
#   Tokens pessoais (Vercel/GitHub/APIs externas) → NUNCA vão para env vars da app
#   APPLE_* → só quando implementares Sign in with Apple
# ============================================================================
