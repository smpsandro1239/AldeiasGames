// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource "db" {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // For local development fallback to file-based SQLite
  // url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["email"]
}

generator clientEmail {
  provider        = "prisma-client-email"
  output        = "../node_modules/@prisma/client/email/index.js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  nome         String?
  telefone     String?
  role         UserRole
  orgId        String?
  org          Organization?
  historico    HistoricoAlteracao[]
  vendas       Venda[]
  recargas     RecargaSaldo[]
  saldo        Decimal   @default(0)
  saldoBloqueado Decimal @default(0)
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?
  // Role enforcement - cannot be both VENDEDOR and PLAYER on same email
  // This is enforced in application logic, not DB level
}

enum UserRole {
  SUPERADMIN
  ORG_ADMIN
  VENDEDOR
  PLAYER
}

model Organization {
  id        String   @id @default(uuid())
  nome      String
  slug      String  @unique
  email     String?
  emailVerified Boolean @default(false)
  status    Boolean @default(true) // active/inactive
  address?  String?
  phone?    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owners    User[]   @relation("orgOwners")
  jogadores  User[]   @relation("orgPlayers")
  vendedores User[]   @relation("orgSellers")
  jogadoresCount Int    @default(0)
  vendasCount Int    @default(0)
  gamesCount Int    @default(0)
  audits    Alteracao[] @relation("orgAlteracoes")
}

model Alteracao {
  id           String   @id @default(uuid())
  jogadaId     String
  tipoAlteracao TipoAlteracao
  dadosOriginais Json?
  valorOriginal Decimal @db.Decimal(10,2)
  dadosNovos   Json?
  valorNovo    Decimal?
  motivo String
  solicitadoPor String
  aprovadoPor String?
  status       StatusAlteracao @default(PENDING)
  timestamp    DateTime @default(now())
  jogada       Jogada @relation(fields: [jogadaId], references: [id])
}

enum TipoAlteracao {
  ANULACAO
  ALTERACAO_NUMERO
  ALTERACAO_CELULA
  CORRECAO_VALOR
}

enum StatusAlteracao {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model Venda {
  id           String   @id @default(uuid())
  jogadorId    String
  jogadaId     String
  tipoJogo     TipoJogo
  valor        Decimal @db.Decimal(10,2)
  metodoPagamento PaymentMethod
  statusPagamento PaymentStatus @default(PENDING)
  statusJogada JogadaStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  confirmadoEm DateTime?
  confirmadoPor String?
  comprovativo String?
  confirmativoUrl String?
  historicoAlteracoes HistoricoAlteracao[]
  jogada       Jogada @relation(fields: [jogadaId], references: [id])
  player       User @relation(fields: [jogadorId], references: [id])
  vendedor     User @relation(fields: [vendedorId], references: [id])
}

enum PaymentMethod {
  CASH
  MBWAY_P2P
  SALDO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  DISPUTED
  REJECTED
  RESOLVED
}

model RecargaSaldo {
  id           String   @id @default(uuid())
  playerId     String
  vendedorId   String
  valor        Decimal @db.Decimal(10,2)
  metodo       PaymentMethod
  comprovativo String?
  status       PaymentStatus @default(PENDING)
  timestamp    DateTime @default(now())
  player       User @relation(fields: [playerId], references: [id])
  vendedor     User @relation(fields: [vendedorId], references: [id])
}

model Jogo {
  id           String   @id @default(uuid())
  orgId        String
  tipo         TipoJogo
  titulo       String
  descricao    String?
  config       Json
  dataInicio   DateTime
  dataFim      DateTime?
  resultadoMocked Json?
  resultadoReal Json?
  apiEuromilhoes Boolean @default(false)
  avisos       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  org          Organization @relation(fields: [orgId], references: [id])
  jogadores    User[]       @relation(fields: [playerId], references: [id])
  historico    HistoricoAlteracao[] @relation(fields: [jogadaId], references: [id])
  // Campos de auditoria rápida
  alteracoesCount Int @default(0)
  ultimaAlteracaoEm DateTime?
}

enum TipoJogo {
  RIFA
  POIO
  RASPADINHA
  LOTERIA
}

enum JogoStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  RETIRED
}

model Vendedor {
  usuarioId String @unique
  email      String
  telefone   String?
  saldoAtual Decimal @default(0) @db.Decimal(10,2)
  saldoBloqueado Decimal @default(0) @db.Decimal(10,2)
  podeAlterarAte DateTime?
  podeAlterarAteExpira DateTime?
  // Controles de imutabilidade
  sorteioRealizado Boolean @default(false)
  raspada Boolean @default(false)
  coordenadasDefinidas Boolean @default(false)
  alteracoesCount Int @default(0)
  ultimaAlteracaoEm DateTime?
  usuario User @relation(fields: [usuarioId], references: [id])
  historico HistoricoAlteracao[] @relation(fields: [jogadaId], references: [id])
}

model HistoricoAlteracao {
  id               String   @id @default(uuid())
  jogadaId       String
  tipoAlteracao  TipoAlteracao
  dadosOriginais Json?
  valorOriginal  Decimal @db.Decimal(10,2)
  dadosNovos     Json?
  valorNovo      Decimal?
  motivo String
  solicitadoPor String
  aprovadoPor String?
  status       StatusAlteracao @default(PENDING)
  timestamp    DateTime @default(now())
  jogada       Jogada @relation(fields: [jogadaId], references: [id])
  player       User @relation(fields: [originPlayerId], references: [id])
  vendedor       User @relation(fields: [originPlayerId], references: [id])
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  userId       String
  userRole     String
  details      Json?
  ipAddress    String?
  timestamp    DateTime @default(now())
}

generator clientEmail {
  provider        = "prisma-client-email"
  output        = "../node_modules/@prisma/client/email/index.js"
}

generator client {
  provider        = "prisma-client-js"
  output        = "../node_modules/@prisma/client/index.js"
}

generator email {
  provider        = "prisma-client-email"
  output        = "../node_modules/@prisma/client/email/index.js"
}

generator clientClientEmail {
  provider        = "prisma-client-email"
  output        = "../node_modules/@prisma/client/email/index.js"
}