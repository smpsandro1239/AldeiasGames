# Database
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="your-secret-key-here"
AUTH_URL="http://localhost:3000"

# GitHub (for API access)
GITHUB_TOKEN="your-github-token-here"

# Email (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Feature flags
NEXT_PUBLIC_API_EUROMILHOES="false"
NEXT_PUBLIC_MODO_TESTE="true"
NEXT_PUBLIC_MANUTENCAO="false"

# SuperAdmin
SUPERADMIN_EMAIL="admin@aldeiasgames.pt"
SUPERADMIN_PASSWORD="change-this-password"

# Rate limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="60000"

# Organization (first)
FIRST_ORG_NAME="Aldeia de São João"
FIRST_ORG_SLUG="aldeia-sao-joao"
FIRST_ORG_EMAIL="presidente@aldeia.pt"